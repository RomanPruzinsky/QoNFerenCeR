{
	"name": "APP_LAUNCHED_trackingInGoogleSheets",
	"nodes": [
		{
			"id": "note1",
			"name": "Setup",
			"type": "n8n-nodes-base.stickyNote",
			"typeVersion": 1,
			"position": [-360, -80],
			"parameters": {
				"width": 320,
				"height": 460,
				"content": "## Before running\n\n1. Connect Google Oauth2 account\n2. Set webhook path prefix to match backend's `$N8N_PATH_PREFIX`\n3. Create Header Auth credential:\n   - header name: `QN-Token`\n   - value: `$BE_N8N_COMMS__AUTH_TOKEN`\n4. Set Google Sheet's column names like this: `timestamp`, `conferenceId`, `userId`, `fullName`, `role`, `error`\n5. Replace `YOUR_SPREADSHEET_ID` in both Google Sheets nodes and both HTTP Request node URLs with real values"
			}
		},
		{
			"id": "webhook1",
			"name": "APP_LAUNCHED Webhook",
			"type": "n8n-nodes-base.webhook",
			"typeVersion": 2,
			"position": [-360, 420],
			"parameters": {
				"httpMethod": "POST",
				"path": "qonferencer_n8n_base/APP_LAUNCHED",
				"authentication": "headerAuth",
				"responseMode": "onReceived",
				"options": {}
			},
			"credentials": {
				"httpHeaderAuth": {
					"id": "qn-token-header-auth",
					"name": "QN-Token Header Auth"
				}
			}
		},
		{
			"id": "setRow",
			"name": "Compute Row",
			"type": "n8n-nodes-base.set",
			"typeVersion": 3.4,
			"position": [-100, 420],
			"parameters": {
				"assignments": {
					"assignments": [
						{ "id": "a1", "name": "timestamp", "type": "string", "value": "={{ $json.body.timestamp }}" },
						{ "id": "a2", "name": "conferenceId", "type": "string", "value": "={{ $json.body.conferenceId }}" },
						{ "id": "a3", "name": "userId", "type": "string", "value": "={{ $json.body.data.user?.userId ?? '' }}" },
						{ "id": "a4", "name": "fullName", "type": "string", "value": "={{ $json.body.data.user?.fullName ?? '' }}" },
						{ "id": "a5", "name": "role", "type": "string", "value": "={{ $json.body.data.user?.role ?? '' }}" },
						{ "id": "a6", "name": "error", "type": "string", "value": "" },
						{ "id": "a7", "name": "rowColor", "type": "string", "value": "={{ $json.body.data.user ? 'green' : 'white' }}" }
					]
				},
				"options": {}
			}
		},
		{
			"id": "appendRow",
			"name": "Append Row",
			"type": "n8n-nodes-base.googleSheets",
			"typeVersion": 4.5,
			"position": [140, 420],
			"onError": "continueErrorOutput",
			"parameters": {
				"resource": "sheet",
				"operation": "append",
				"documentId": { "__rl": true, "mode": "id", "value": "YOUR_SPREADSHEET_ID" },
				"sheetName": { "__rl": true, "mode": "list", "value": "gid=0", "cachedResultName": "Sheet1" },
				"columns": {
					"mappingMode": "defineBelow",
					"value": {
						"timestamp": "={{ $json.timestamp }}",
						"conferenceId": "={{ $json.conferenceId }}",
						"userId": "={{ $json.userId }}",
						"fullName": "={{ $json.fullName }}",
						"role": "={{ $json.role }}",
						"error": "={{ $json.error }}"
					}
				},
				"options": {}
			},
			"credentials": {
				"googleSheetsOAuth2Api": {
					"id": "google-sheets-oauth2",
					"name": "Google Sheets account"
				}
			}
		},
		{
			"id": "colorSuccess",
			"name": "Color Row (login state)",
			"type": "n8n-nodes-base.httpRequest",
			"typeVersion": 4.2,
			"position": [400, 300],
			"parameters": {
				"method": "POST",
				"url": "https://sheets.googleapis.com/v4/spreadsheets/YOUR_SPREADSHEET_ID:batchUpdate",
				"authentication": "predefinedCredentialType",
				"nodeCredentialType": "googleSheetsOAuth2Api",
				"sendBody": true,
				"specifyBody": "json",
				"jsonBody": "={{ { \"requests\": [ { \"repeatCell\": { \"range\": { \"sheetId\": 0, \"startRowIndex\": $json.row_number - 1, \"endRowIndex\": $json.row_number, \"startColumnIndex\": 0, \"endColumnIndex\": 6 }, \"cell\": { \"userEnteredFormat\": { \"backgroundColor\": $('Compute Row').item.json.rowColor === 'green' ? {\"red\":0.72,\"green\":0.88,\"blue\":0.72} : {\"red\":1,\"green\":1,\"blue\":1} } }, \"fields\": \"userEnteredFormat.backgroundColor\" } } ] } }}",
				"options": {}
			},
			"credentials": {
				"googleSheetsOAuth2Api": {
					"id": "google-sheets-oauth2",
					"name": "Google Sheets account"
				}
			}
		},
		{
			"id": "setError",
			"name": "Compute Error Row",
			"type": "n8n-nodes-base.set",
			"typeVersion": 3.4,
			"position": [400, 560],
			"parameters": {
				"assignments": {
					"assignments": [
						{ "id": "e1", "name": "timestamp", "type": "string", "value": "={{ $('Compute Row').item.json.timestamp }}" },
						{ "id": "e2", "name": "conferenceId", "type": "string", "value": "={{ $('Compute Row').item.json.conferenceId }}" },
						{ "id": "e3", "name": "userId", "type": "string", "value": "={{ $('Compute Row').item.json.userId }}" },
						{ "id": "e4", "name": "fullName", "type": "string", "value": "={{ $('Compute Row').item.json.fullName }}" },
						{ "id": "e5", "name": "role", "type": "string", "value": "={{ $('Compute Row').item.json.role }}" },
						{ "id": "e6", "name": "error", "type": "string", "value": "={{ $json.error?.message ?? $json.message ?? 'unknown error' }}" },
						{ "id": "e7", "name": "rowColor", "type": "string", "value": "red" }
					]
				},
				"options": {}
			}
		},
		{
			"id": "appendError",
			"name": "Append Error Row",
			"type": "n8n-nodes-base.googleSheets",
			"typeVersion": 4.5,
			"position": [640, 560],
			"parameters": {
				"resource": "sheet",
				"operation": "append",
				"documentId": { "__rl": true, "mode": "id", "value": "YOUR_SPREADSHEET_ID" },
				"sheetName": { "__rl": true, "mode": "list", "value": "gid=0", "cachedResultName": "Sheet1" },
				"columns": {
					"mappingMode": "defineBelow",
					"value": {
						"timestamp": "={{ $json.timestamp }}",
						"conferenceId": "={{ $json.conferenceId }}",
						"userId": "={{ $json.userId }}",
						"fullName": "={{ $json.fullName }}",
						"role": "={{ $json.role }}",
						"error": "={{ $json.error }}"
					}
				},
				"options": {}
			},
			"credentials": {
				"googleSheetsOAuth2Api": {
					"id": "google-sheets-oauth2",
					"name": "Google Sheets account"
				}
			}
		},
		{
			"id": "colorError",
			"name": "Color Row (error)",
			"type": "n8n-nodes-base.httpRequest",
			"typeVersion": 4.2,
			"position": [880, 560],
			"parameters": {
				"method": "POST",
				"url": "https://sheets.googleapis.com/v4/spreadsheets/YOUR_SPREADSHEET_ID:batchUpdate",
				"authentication": "predefinedCredentialType",
				"nodeCredentialType": "googleSheetsOAuth2Api",
				"sendBody": true,
				"specifyBody": "json",
				"jsonBody": "={{ { \"requests\": [ { \"repeatCell\": { \"range\": { \"sheetId\": 0, \"startRowIndex\": $json.row_number - 1, \"endRowIndex\": $json.row_number, \"startColumnIndex\": 0, \"endColumnIndex\": 6 }, \"cell\": { \"userEnteredFormat\": { \"backgroundColor\": {\"red\":0.96,\"green\":0.7,\"blue\":0.7} } }, \"fields\": \"userEnteredFormat.backgroundColor\" } } ] } }}",
				"options": {}
			},
			"credentials": {
				"googleSheetsOAuth2Api": {
					"id": "google-sheets-oauth2",
					"name": "Google Sheets account"
				}
			}
		}
	],
	"connections": {
		"APP_LAUNCHED Webhook": {
			"main": [[{ "node": "Compute Row", "type": "main", "index": 0 }]]
		},
		"Compute Row": {
			"main": [[{ "node": "Append Row", "type": "main", "index": 0 }]]
		},
		"Append Row": {
			"main": [
				[{ "node": "Color Row (login state)", "type": "main", "index": 0 }],
				[{ "node": "Compute Error Row", "type": "main", "index": 0 }]
			]
		},
		"Compute Error Row": {
			"main": [[{ "node": "Append Error Row", "type": "main", "index": 0 }]]
		},
		"Append Error Row": {
			"main": [[{ "node": "Color Row (error)", "type": "main", "index": 0 }]]
		}
	},
	"active": false,
	"settings": { "executionOrder": "v1" },
	"pinData": {}
}
