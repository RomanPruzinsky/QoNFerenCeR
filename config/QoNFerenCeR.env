API_VERSION=1
EVENT_ID=TODO_CHANGEME

BACKEND_BASE_URL=http://192.168.100.68:8081/
KEYCLOAK_BASE_URL=http://192.168.100.68:8080/

# Base URL that Keycloak calls itself; can equal KEYCLOAK_BASE_URL in prod
KEYCLOAK_HOSTNAME=http://localhost:8080

POSTGRES_USER=app
POSTGRES_PASSWORD=secret

# Keycloak console account
KC_CONSOLEADMIN_USERNAME=admin
KC_CONSOLEADMIN_PASSWORD=admin-passw

# Must match "secret" of "qonferencer-backend-admin" client in `realm-export`
KC_BEADMIN_CLIENT_SECRET=backend-admin-secret

N8N_ENABLED=true
N8N_PATH_PREFIX=qonferencer_n8n_base
N8N_TIMEOUT_MS=3000

# N8N secrets
BE_N8N_COMMS__AUTH_TOKEN=TODO_CHANGEME
N8N_ENCRYPTION_KEY=TODO_CHANGEME

# Android release signing
RELEASE_KEYSTORE_PATH=config/TODO_CHANGEME
RELEASE_KEY_ALIAS=TODO_CHANGEME
RELEASE_KEYSTORE_PASSWORD=TODO_CHANGEME
RELEASE_KEY_PASSWORD=TODO_CHANGEME
