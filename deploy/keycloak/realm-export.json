{
	"realm": "qonferencer",
	"enabled": true,
	"sslRequired": "none",
	"accessTokenLifespan": 120,
	"ssoSessionIdleTimeout": 432000,
	"ssoSessionMaxLifespan": 432000,
	"registrationAllowed": false,
	"resetPasswordAllowed": false,
	"editUsernameAllowed": false,
	"bruteForceProtected": true,
	"roles": {
		"realm": [
			{
				"name": "ANONYM",
				"description": "Not logged in / public content"
			},
			{
				"name": "VISITOR",
				"description": "Attendee"
			},
			{
				"name": "VOLUNTEER",
				"description": "VISITOR who sometimes helps"
			},
			{
				"name": "ORGANISER",
				"description": "Staff"
			},
			{
				"name": "LEADER",
				"description": "Teamleader"
			},
			{
				"name": "ADMIN",
				"description": "System administrator, developer"
			}
		]
	},
	"clients": [
		{
			"clientId": "qonferencer-android",
			"name": "QoNFerenCeR Android client",
			"enabled": true,
			"publicClient": true,
			"standardFlowEnabled": false,
			"directAccessGrantsEnabled": true,
			"serviceAccountsEnabled": false,
			"redirectUris": [],
			"webOrigins": [],
			"attributes": {
				"post.logout.redirect.uris": "+"
			},
			"protocolMappers": [
				{
					"name": "isSpeaker",
					"protocol": "openid-connect",
					"protocolMapper": "oidc-usermodel-attribute-mapper",
					"consentRequired": false,
					"config": {
						"user.attribute": "isSpeaker",
						"claim.name": "isSpeaker",
						"jsonType.label": "boolean",
						"id.token.claim": "true",
						"access.token.claim": "true",
						"userinfo.token.claim": "true"
					}
				},
				{
					"name": "canCheckUsers",
					"protocol": "openid-connect",
					"protocolMapper": "oidc-usermodel-attribute-mapper",
					"consentRequired": false,
					"config": {
						"user.attribute": "canCheckUsers",
						"claim.name": "canCheckUsers",
						"jsonType.label": "boolean",
						"id.token.claim": "true",
						"access.token.claim": "true",
						"userinfo.token.claim": "true"
					}
				},
				{
					"name": "canFoodCheck",
					"protocol": "openid-connect",
					"protocolMapper": "oidc-usermodel-attribute-mapper",
					"consentRequired": false,
					"config": {
						"user.attribute": "canFoodCheck",
						"claim.name": "canFoodCheck",
						"jsonType.label": "boolean",
						"id.token.claim": "true",
						"access.token.claim": "true",
						"userinfo.token.claim": "true"
					}
				}
			]
		},
		{
			"clientId": "qonferencer-backend-admin",
			"name": "QoNFerenCeR backend admin (service account)",
			"enabled": true,
			"publicClient": false,
			"secret": "backend-admin-secret",
			"standardFlowEnabled": false,
			"directAccessGrantsEnabled": false,
			"serviceAccountsEnabled": true,
			"redirectUris": [],
			"webOrigins": []
		}
	],
	"users": [
		{
			"username": "First Admin",
			"enabled": true,
			"emailVerified": true,
			"email": "admin@qonferencer.local",
			"firstName": "First",
			"lastName": "Admin",
			"credentials": [
				{
					"type": "password",
					"value": "changeme",
					"temporary": false
				}
			],
			"realmRoles": [
				"ADMIN"
			],
			"attributes": {
				"isSpeaker": [
					"false"
				],
				"canCheckUsers": [
					"true"
				],
				"canFoodCheck": [
					"true"
				]
			}
		},
		{
			"username": "service-account-qonferencer-backend-admin",
			"enabled": true,
			"serviceAccountClientId": "qonferencer-backend-admin",
			"clientRoles": {
				"realm-management": [
					"manage-users",
					"view-users",
					"view-realm"
				]
			}
		}
	],
	"attributes": {
		"kc.user.profile.config": "{\"unmanagedAttributePolicy\": \"ENABLED\", \"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"email\", \"displayName\": \"${email}\", \"validations\": {\"email\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"isSpeaker\", \"displayName\": \"isSpeaker\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false}, {\"name\": \"canCheckUsers\", \"displayName\": \"canCheckUsers\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false}, {\"name\": \"canFoodCheck\", \"displayName\": \"canFoodCheck\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false}]}"
	}
}
